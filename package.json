{
  "name": "grimorio-rpg",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "start:test": "node tools/static-server.mjs",
    "check:contracts": "node tools/audit-dom-contracts.mjs",
    "check:css": "node tools/audit-css-ownership.mjs",
    "test:domain": "node --test --test-isolation=none tests/domain/*.test.js",
    "test:contracts": "playwright test tests/contracts",
    "test:e2e": "playwright test tests/e2e",
    "test:visual": "playwright test tests/visual",
    "test": "npm run check:contracts && npm run test:domain && playwright test tests/contracts tests/e2e"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1"
  }
}
